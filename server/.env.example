# Neon PostgreSQL pooled or direct connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
PORT=3001
NODE_ENV=development
CORS_ORIGINS="http://localhost:5173,http://localhost:4173"
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
ADMIN_EMAIL="admin@example.com"
# Use a bcrypt hash, not a plain password. Generate with: node -e "require('bcryptjs').hash('YourStrongPassword',12).then(console.log)"
ADMIN_PASSWORD_HASH="$2b$12$replace_with_a_real_bcrypt_hash"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
MAX_UPLOAD_MB=10
